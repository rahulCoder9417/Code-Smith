# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real API keys.

# Which provider to talk to: openai | gemini | groq | nvidia
LLM_PROVIDER=groq

# The model id, as that provider names it.
LLM_MODEL=llama-3.3-70b-versatile

# Your API key for the provider above.
LLM_API_KEY=

# Which system prompt to load from app/prompts/system/ (without .txt).
# One of: teacher | python_mentor | debugger | interviewer | technical_writer
SYSTEM_PROMPT=teacher

# How chatty the internal logs are: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
